{
  "name": "baking-converter",
  "version": "0.0.1",
  "description": "Stencil Baking Converter Component",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/baking-converter/baking-converter.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./baking-converter": {
      "types": "./dist/components/baking-converter.d.ts",
      "import": "./dist/components/baking-converter.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VictoriaMineva/baking-converter.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --prod --watch",
    "generate": "stencil generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@stencil/core": "^4.45.2",
    "@stencil/eslint-plugin": "^1.4.1",
    "@stencil/vitest": "^1.8.3",
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/browser-playwright": "^4.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "playwright": "^1.52.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
